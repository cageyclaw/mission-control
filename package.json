{
  "name": "occ-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "OpenClaw Command Center desktop operator console",
  "author": {
    "name": "CageyCloud",
    "email": "support@cageycloud.com"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npx --yes vitest run",
    "preview": "vite preview",
    "preview:vite": "vite preview",
    "electron": "electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux deb",
    "dist": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.cageycloud.occ",
    "productName": "OpenClaw Command Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../system-metrics-server",
        "to": "system-metrics-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "executableName": "occ",
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "Name": "OCC",
          "Icon": "occ",
          "Categories": "System;",
          "StartupWMClass": "occ"
        }
      }
    },
    "deb": {
      "afterInstall": "scripts/deb-postinstall.sh"
    }
  }
}
